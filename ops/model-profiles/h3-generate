#!/usr/bin/env python3
"""One-shot MiniMax H3 text-to-video+audio generator for PGX ComfyUI.

Use --realism for the installed H3 Realism People LoRA (recommended for
natural human-centred footage), or --lora NAME for another H3-compatible LoRA.
"""
import argparse
import json
import random
import subprocess
import time
import urllib.request
import uuid

BASE = "http://127.0.0.1:8188"
REALISM_LORA = "h3-realism-people-t2v-i2v-r2v.safetensors"
REALISM_TRIGGER = "r34l1sm"


def get_json(path):
    with urllib.request.urlopen(BASE + path, timeout=10) as response:
        return json.load(response)


def post_json(path, payload):
    request = urllib.request.Request(
        BASE + path,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def is_ready():
    try:
        get_json("/system_stats")
        return True
    except Exception:
        return False


def start_service():
    subprocess.run(["/home/aski/.local/bin/h3ctl", "start"], check=True)
    for _ in range(180):
        if is_ready():
            return
        time.sleep(1)
    raise RuntimeError("MiniMax H3 ComfyUI did not become ready")


def make_prompt(text, width, height, length, steps, seed, prefix, lora_name=None, lora_strength=0.8):
    workflow = {
        "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "10Eros_Max_h3_hybrid_beta5_int8.safetensors", "weight_dtype": "default"}},
        "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
        "3": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
        "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
        "5": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["2", 0], "vae": ["3", 0], "prompt": text, "width": width, "height": height, "length": length}},
        "6": {"class_type": "RandomNoise", "inputs": {"noise_seed": seed}},
        "7": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
        "8": {"class_type": "BasicScheduler", "inputs": {"model": ["1", 0], "scheduler": "simple", "steps": steps, "denoise": 1.0}},
        "9": {"class_type": "BasicGuider", "inputs": {"model": ["1", 0], "conditioning": ["5", 0]}},
        "10": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["6", 0], "guider": ["9", 0], "sampler": ["7", 0], "sigmas": ["8", 0], "latent_image": ["5", 1]}},
        "11": {"class_type": "VAEDecode", "inputs": {"samples": ["10", 0], "vae": ["3", 0]}},
        "12": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["10", 0], "vae": ["4", 0]}},
        "13": {"class_type": "CreateVideo", "inputs": {"images": ["11", 0], "audio": ["12", 0], "fps": 24.0, "bit_depth": 8}},
        "14": {"class_type": "SaveVideo", "inputs": {"video": ["13", 0], "filename_prefix": prefix, "format": "auto", "codec": "auto"}},
    }
    if lora_name:
        workflow["15"] = {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": lora_name, "strength_model": lora_strength}}
        workflow["8"]["inputs"]["model"] = ["15", 0]
        workflow["9"]["inputs"]["model"] = ["15", 0]
    return workflow


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("prompt")
    parser.add_argument("--duration", type=float, default=2.0)
    parser.add_argument("--width", type=int, default=608)
    parser.add_argument("--height", type=int, default=352)
    parser.add_argument("--steps", type=int, default=20)
    parser.add_argument("--seed", type=int, default=None)
    parser.add_argument("--prefix", default="video/MiniMax_H3")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--realism", action="store_true", help="Apply the H3 Realism People LoRA for natural live-action people.")
    group.add_argument("--lora", help="An H3-compatible LoRA filename from ComfyUI/models/loras.")
    parser.add_argument("--lora-strength", type=float, default=0.8, help="LoRA model strength (Realism recommended: 0.6-0.8; maximum 1.0).")
    args = parser.parse_args()

    if args.width % 32 or args.height % 32:
        parser.error("width and height must be multiples of 32")
    if not 0.0 <= args.lora_strength <= 2.0:
        parser.error("--lora-strength must be between 0.0 and 2.0")

    lora_name = REALISM_LORA if args.realism else args.lora
    prompt = args.prompt
    if args.realism and REALISM_TRIGGER not in prompt:
        prompt = f"{REALISM_TRIGGER}, {prompt}"

    raw = max(5, round(args.duration * 24))
    length = raw + (5 - (raw % 17)) % 17
    seed = args.seed if args.seed is not None else random.randrange(2**48)
    if not is_ready():
        start_service()

    workflow = make_prompt(prompt, args.width, args.height, length, args.steps, seed, args.prefix, lora_name, args.lora_strength)
    client_id = str(uuid.uuid4())
    queued = post_json("/prompt", {"prompt": workflow, "client_id": client_id})
    if "error" in queued:
        raise RuntimeError(json.dumps(queued, ensure_ascii=False))
    prompt_id = queued["prompt_id"]
    print(json.dumps({"event": "queued", "prompt_id": prompt_id, "seed": seed, "frames": length, "resolution": [args.width, args.height], "lora": lora_name, "lora_strength": args.lora_strength if lora_name else None}, ensure_ascii=False), flush=True)

    started = time.time()
    while True:
        history = get_json("/history/" + prompt_id)
        if prompt_id in history:
            result = history[prompt_id]
            status = result.get("status", {})
            if status.get("status_str") == "error" or not status.get("completed", False):
                raise RuntimeError(json.dumps(result, ensure_ascii=False))
            files = []
            for output in result.get("outputs", {}).values():
                for key in ("videos", "gifs", "images"):
                    files.extend(output.get(key, []))
            print(json.dumps({"event": "completed", "elapsed_seconds": round(time.time() - started, 2), "files": files}, ensure_ascii=False))
            return 0
        queue = get_json("/queue")
        print(json.dumps({"event": "progress", "elapsed_seconds": round(time.time() - started, 1), "queue_running": len(queue.get("queue_running", [])), "queue_pending": len(queue.get("queue_pending", []))}), flush=True)
        time.sleep(10)


if __name__ == "__main__":
    raise SystemExit(main())
