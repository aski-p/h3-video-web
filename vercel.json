{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "1mb",
        "runtime": "python3.12",
        "handler": "server.handler"
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/server" }
  ]
}
