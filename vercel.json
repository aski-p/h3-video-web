{
  "version": 2,
  "builds": [
    {
      "src": "backend_proxy.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "1mb",
        "runtime": "python3.12",
        "handler": "backend_proxy.handler"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
