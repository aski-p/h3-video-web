{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/server.py"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/server.py"},
    {"src": "/(.*)", "dest": "/"}
  ],
  "env": {
    "COMFY_BASE": "http://192.168.50.213:8188",
    "H3_OUT_DIR": "/tmp/h3-web-output"
  }
}
